
@article{Yang:26,
author = {Songlin Yang and Dingcheng Qi and Qingan Tang and Ran Ye and Yong-Hong Ye},
journal = {Opt. Lett.},
keywords = {Diffraction limit; Illumination; Imaging systems; Imaging techniques; Spatial resolution; Super resolution imaging},
number = {21},
pages = {6002--6005},
publisher = {Optica Publishing Group},
title = {Azimuthal-rotation evanescent-wave illumination incoherent scattering microscopy (AR-EISM) for label-free, high-contrast imaging},
volume = {51},
month = {Nov},
year = {2026},
url = {https://opg.optica.org/ol/abstract.cfm?URI=ol-51-21-6002},
doi = {10.1364/OL.614608},
file = {2026ol.pdf},
abstract = {Evanescent-wave (EW) illumination provides high sensitivity and high signal-to-noise ratio (SNR) for label-free imaging. However, coherent illumination introduces speckle and interference artifacts, while single-direction illumination leads to direction-dependent spatial resolution. Here, we propose azimuthal-rotation evanescent-wave illumination incoherent scattering microscopy (AR-EISM), which continuously rotates incoherent illumination over 360\&\#x2218; during a single exposure to reduce the directional dependence of spatial resolution. Imaging experiments with polystyrene nanoparticles using EW illumination with a transverse wavevector of approximately 1.3k0 demonstrate that AR-EISM achieves a lateral resolution close to the theoretical Abbe diffraction limit, together with a 1.37-fold increase in SNR and higher imaging contrast compared with conventional dark-field microscopy. These findings highlight the potential of AR-EISM for high-contrast, label-free imaging.},
}


@article{Yang:25,
author = {Songlin Yang and Jia Yang and Ran Ye and Yurong Cao and Yong-Hong Ye},
journal = {Opt. Lett.},
keywords = {Biomedical imaging; Confocal laser scanning microscopy; Imaging systems; Imaging techniques; Real time imaging; Super resolution imaging},
number = {17},
pages = {5478--5481},
publisher = {Optica Publishing Group},
title = {Resolution enhancement in evanescent light illumination microscopy using microsphere lenses},
volume = {50},
month = {Sep},
year = {2025},
url = {https://opg.optica.org/ol/abstract.cfm?URI=ol-50-17-5478},
doi = {10.1364/OL.569320},
file = {2025ol.pdf},
abstract = {Weakly scattering samples such as low-refractive-index nanomaterials present significant challenges in super-resolution imaging, because their weak scattering signals are difficult to distinguish from background noise. Here, we propose microsphere-enhanced evanescent light illumination microscopy (MS-EIM) for the label-free super-resolution imaging of weakly scattering samples. We used the MS-EIM method to perform simulated imaging of transparent samples with a 100-nm gap to investigate its imaging performance. Subsequently, the feasibility of MS-EIM for super-resolution imaging of weakly scattering samples was experimentally validated. This MS-EIM is a wide-field, real-time imaging technique with potential applications in the field of high-speed, label-free biomedical imaging.},
}

@article{10.1063/5.0225792,
  title = {Waveguide-Based Microscope Slide for Label-Free High-Resolution Imaging},
  author = {Yang, Songlin and Sun, Qihao and Cao, Yurong and Ye, Yong-Hong and Zhang, Jiayu},
  year = 2024,
  month = aug,
  journal = {Applied Physics Letters},
  volume = {125},
  number = {6},
  eprint = {https://pubs.aip.org/aip/apl/article-pdf/doi/10.1063/5.0225792/20095216/063701\_1\_5.0225792.pdf},
  pages = {063701},
  issn = {0003-6951},
  doi = {10.1063/5.0225792},
  file = {2024apl.pdf},
  abstract = {Waveguide-based total internal reflection fluorescence microscopy has been widely adopted due to its excellent signal-to-noise ratio over a large field of view. However, with the increasing demand for label-free imaging, waveguide-based evanescent light scattering microscopy (ESM) has also garnered significant attention. Here, we present a low-cost waveguide-based microscope slide that offers easier integration with conventional optical microscopy. This microscope slide uses an incoherent light source coupled to a lithium tantalate (LT) planar waveguide to generate an evanescent light that illuminates samples located within a few hundred nanometers of the waveguide surface. We perform its application for imaging chromium nanoholes and polystyrene nanospheres, demonstrating its label-free, high-resolution, high-contrast imaging performance. LT waveguide microscope slides provide a simple and effective solution for ESM.}
}
